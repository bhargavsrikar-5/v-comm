# Required: generate a random secret of at least 32 bytes. Never commit a real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION_SECONDS=43200

# Local H2 is used by default. Example MySQL settings:
# DB_URL=jdbc:mysql://localhost:3306/vcomm_db?createDatabaseIfNotExist=true&serverTimezone=UTC
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_USERNAME=vcomm_app
# DB_PASSWORD=replace-with-a-local-database-password

# Optional initial administrator. If both values are blank, no admin account is created.
VCOMM_ADMIN_EMAIL=
VCOMM_ADMIN_PASSWORD=
VCOMM_ADMIN_NAME=V-COMM Administrator

# Optional comma-separated institutional email domains supplied by the institution.
# Leave blank for local development; no domain is guessed by the project.
VCOMM_ALLOWED_EMAIL_DOMAINS=

# Comma-separated allowed browser origins; set to exact production origins.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
